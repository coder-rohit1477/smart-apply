generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum JobType {
  REMOTE
  HYBRID
  ONSITE
}

enum JobFreshnessBucket {
  LAST_24_HOURS
  LAST_3_DAYS
  LAST_7_DAYS
  STALE
  UNKNOWN
}

enum ApplicationStatus {
  DRAFT
  APPLIED
  SCREEN
  SHORTLIST
  INTERVIEW
  OFFER
  REJECTED
}

enum InsightCategory {
  MATCHING
  ATS
  OUTREACH
  INTERVIEW
}

model UserProfile {
  id           String           @id @default(cuid())
  clerkUserId  String           @unique
  email        String           @unique
  firstName    String?
  lastName     String?
  headline     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  resumes      Resume[]
  resumeAnalyses ResumeAnalysis[]
  jobMatches   JobMatch[]
  applications JobApplication[]
  insights     AiInsight[]
}

model Resume {
  id           String      @id @default(cuid())
  userId       String
  name         String
  version      String?
  targetRole   String?
  summary      String?
  atsScore     Int         @default(0)
  parsedSkills String[]    @default([])
  fileName     String?
  fileType     String?
  fileSize     Int?
  fileUrl      String?
  rawText      String?     @db.Text
  parsedData   Json?
  extractedSkills String[] @default([])
  parentId     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Resume?     @relation("ResumeVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions     Resume[]    @relation("ResumeVersions")
  analyses     ResumeAnalysis[]

  @@index([userId, createdAt])
  @@index([parentId])
}

model ResumeAnalysis {
  id                String      @id @default(cuid())
  resumeId          String
  userId            String
  provider          String
  model             String
  promptVersion     String
  executiveSummary  String      @db.Text
  atsScore          Int
  jobReadinessScore Int
  strengths         String[]    @default([])
  weaknesses        String[]    @default([])
  missingSkills     String[]    @default([])
  recommendations   String[]    @default([])
  analysisData      Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  resume            Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user              UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
  @@index([userId, createdAt])
}

model JobListing {
  id              String           @id @default(cuid())
  source          String
  externalId      String?          @unique
  company         String
  title           String
  location        String
  type            JobType
  salaryRange     String?
  description     String           @db.Text
  applyUrl        String?
  duration        String?
  experienceLevel String?
  isInternship    Boolean          @default(false)
  isFresherFriendly Boolean       @default(false)
  freshnessBucket JobFreshnessBucket @default(UNKNOWN)
  keywords        String[]         @default([])
  postedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  applications    JobApplication[]
  matches         JobMatch[]

  @@index([freshnessBucket, postedAt])
  @@index([isInternship, isFresherFriendly])
}

model JobMatch {
  id            String      @id @default(cuid())
  userId        String
  jobId         String
  matchScore    Int
  atsScore      Int
  reason        String
  missingSkills String[]
  createdAt     DateTime    @default(now())
  user          UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           JobListing  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model JobApplication {
  id          String            @id @default(cuid())
  userId      String
  jobId       String
  status      ApplicationStatus @default(DRAFT)
  coverLetter String?
  notes       String?
  submittedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        UserProfile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         JobListing        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

enum InsightPriority {
  LOW
  MEDIUM
  HIGH
}

model AiInsight {
  id        String          @id @default(cuid())
  userId    String
  category  InsightCategory
  title     String
  content   String
  priority  InsightPriority @default(MEDIUM)
  isActionable Boolean      @default(false)
  isCompleted  Boolean      @default(false)
  metadata  Json?
  createdAt DateTime        @default(now())
  user      UserProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
